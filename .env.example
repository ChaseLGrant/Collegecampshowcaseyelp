# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (required for live data, auth, reviews) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Demo mode ----
# When Supabase is not configured the site runs on clearly labeled SAMPLE data.
# Set to "false" in production to show empty states instead of sample data.
CAMPGRADE_DEMO_DATA=true

# ---- Stripe (required for paid plans) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- The Athlete Market cross-product entitlements ----
# Base URL of The Athlete Market account service (OAuth-style link flow).
ATHLETE_MARKET_BASE_URL=
ATHLETE_MARKET_CLIENT_ID=
# Shared secret used to verify signed link tokens and server-to-server calls (HMAC-SHA256).
ATHLETE_MARKET_SHARED_SECRET=

# ---- Scheduled jobs ----
# Random long string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ---- AI research summaries (optional) ----
ANTHROPIC_API_KEY=

# ---- Security ----
# Random string used to hash reviewer IPs for abuse detection (raw IPs are never stored).
IP_HASH_SALT=
