# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database: PostgreSQL (Railway) ----
# Use Railway's PUBLIC proxy URL (…proxy.rlwy.net:PORT) when the app runs outside Railway (e.g. Vercel).
# Leave blank to run in preview mode with labeled sample data.
DATABASE_URL=
# Connections per server instance (keep small on serverless).
DATABASE_POOL_MAX=5

# ---- Auth.js (NextAuth v5) ----
# Required for sign-in. Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Optional Google sign-in. Authorized redirect URI: https://<domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Attendance-proof storage (S3-compatible; Railway Storage Bucket) ----
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "virtual-host" (default, Railway) or "path"
S3_URL_STYLE=

# ---- Demo mode ----
# No database: sample data shows unless this is "false".
# With a database: sample data shows ONLY while no camps are published AND this is "true".
CAMPGRADE_DEMO_DATA=true

# ---- Roster Insider / The Athlete Market CTAs ----
# Where Insider CTAs link until Stripe prices exist. Default: https://theathletemarket.com
INSIDER_CTA_URL=
# "Free eval review call" link. Default: INSIDER_CTA_URL
EVAL_CALL_URL=

# ---- Stripe (required for paid plans) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- The Athlete Market cross-product entitlements ----
ATHLETE_MARKET_BASE_URL=
ATHLETE_MARKET_CLIENT_ID=
# Shared secret used to verify signed link tokens and server-to-server calls (HMAC-SHA256).
ATHLETE_MARKET_SHARED_SECRET=

# ---- Scheduled jobs ----
# Random long string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ---- AI research summaries (optional) ----
ANTHROPIC_API_KEY=

# ---- Security ----
# Random string used to hash reviewer IPs for abuse detection (raw IPs are never stored).
IP_HASH_SALT=
